<% content_for :title, "Workout" %>

<h1>Workout — <%= @workout_session.created_at.in_time_zone(Current.user.time_zone).strftime("%b %-d, %Y") %></h1>

<% if @workout_exercises.any? %>
  <p class="hint">Drag the handle to reorder exercises for this workout.</p>

  <div
    class="list"
    data-controller="sortable"
    data-sortable-url-value="<%= reorder_workout_session_workout_exercises_path(@workout_session) %>"
    data-action="dragover->sortable#dragOver drop->sortable#drop"
  >
    <% @workout_exercises.each do |workout_exercise| %>
      <div class="list-row" id="<%= dom_id(workout_exercise) %>" data-sortable-target="item" data-id="<%= workout_exercise.id %>">
        <span
          class="drag-handle"
          draggable="true"
          data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
        >⠿</span>
        <%= link_to workout_exercise_path(workout_exercise) do %>
          <div class="list-row-title"><%= workout_exercise.position %>. <%= workout_exercise.exercise.name %></div>
          <div class="list-row-subtitle"><%= workout_exercise.summary %></div>
        <% end %>
        <%= button_to "Delete", workout_exercise_path(workout_exercise), method: :delete, class: "btn btn-ghost btn-danger", form: { data: { turbo_confirm: "Remove #{workout_exercise.exercise.name} from this workout?" } } %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">No exercises added yet.</div>
<% end %>

<%= link_to "Add more exercises", edit_workout_session_path(@workout_session), class: "btn" %>
<%= button_to "Delete workout", workout_session_path(@workout_session), method: :delete, class: "btn btn-ghost btn-danger", form: { data: { turbo_confirm: "Delete this workout?" } } %>
