<%= form_with model: exercise do |form| %>
  <% if exercise.errors.any? %>
    <div class="form-errors">
      <% exercise.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, autofocus: true %>
  </div>

  <div class="field checkbox-field">
    <%= form.check_box :default_selected %>
    <%= form.label :default_selected, "Include by default when starting a new workout" %>
  </div>

  <div class="field checkbox-field">
    <%= form.check_box :uses_barbell %>
    <%= form.label :uses_barbell, "Uses a barbell (starts sets at the #{Exercise::BARBELL_WEIGHT}kg bar weight)" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
